rules_version = '2';

// QR PDFs generated by the vendor and attached from the admin dashboard.
service firebase.storage {
  match /b/{bucket}/o {
    match /qr-pdfs/{docId}/{fileName} {
      // Download links are shared with branches, so reads are public.
      allow get: if true;

      // Attaching or replacing a PDF. Split from delete deliberately:
      // request.resource is null on a delete, so folding these conditions into
      // a blanket `write` denies deletes as an accident of evaluation rather
      // than as a decision. A wrong attachment is corrected by re-uploading
      // over it, which is an update.
      allow create, update: if request.auth != null
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType == 'application/pdf';

      // Every visitor holds an anonymous token, so a client-side delete would
      // let anyone wipe merchants' QR codes. Remove objects from the console.
      // Mirrors `allow delete: if false` on the leads collection.
      allow delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
