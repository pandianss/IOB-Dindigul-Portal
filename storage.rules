rules_version = '2';

// QR PDFs generated by the vendor and attached from the admin dashboard.
service firebase.storage {
  match /b/{bucket}/o {
    match /qr-pdfs/{docId}/{fileName} {
      allow read: if true;                       // download links are shared with branches
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
