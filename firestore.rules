rules_version = '2';

// IOB Dindigul Merchant Services Portal
//
// SCOPE NOTE: the portal authenticates staff with a roll number + password held
// in the browser, not with Firebase Auth. These rules therefore gate on
// anonymous Firebase Auth, which stops drive-by access from anyone who merely
// reads the config out of the page source, but does NOT prove who the caller
// is. To make this genuinely secure you still need, in order of importance:
//   1. App Check (reCAPTCHA Enterprise) so only the real site can call the API.
//   2. Real Firebase Auth accounts for staff, then swap the `signedIn()` checks
//      below for role checks against a custom claim.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A real, named admin — not the shared dashboard password, which is a
    // client-side gate only and cannot be checked here. Membership is a
    // document under /admins keyed by the account's Firebase Auth uid, so
    // admins are granted and revoked from the console with no redeploy.
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Identity and payment fields. A wrong value here sends money to the wrong
    // place, so correcting one requires an admin rather than any visitor
    // holding an anonymous token.
    function onlyCorrectableFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'ACCOUNTNO', 'ACCOUNT_NO', 'IFSC', 'EMAILID', 'MOBILENO',
          'MOBILE_NO', 'MOBILE_NUMBER', 'MERCHANTNAME', 'ACCOUNT_NAME',
          'MERCHANT_NAME', 'VPA', 'MERCHANTVPA', 'GSTNO',
          'CORRECTED_AT', 'CORRECTED_BY', 'CORRECTION_HISTORY',
          'UPDATED_DATE', 'UPDATED_AT'
        ]);
    }

    // Fields a branch user is allowed to set when creating a request.
    function validNewLead() {
      return request.resource.data.keys().hasAll(['type', 'STATUS', 'CREATED_AT'])
          && request.resource.data.type in ['qr', 'soundbox', 'lead']
          && request.resource.data.STATUS == 'Pending Review'
          && request.resource.data.size() < 60;
    }

    // Fields the admin/vendor workflow is allowed to change afterwards.
    function onlyWorkflowFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'STATUS', 'VENDOR_REMARKS', 'MERCHANTVPA', 'QR_PDF_URL', 'PDF_NAME',
          'COMPLETED_DATE', 'UPDATED_DATE', 'UPDATED_AT',
          'DOWNLOAD_COUNT', 'SOUNDBOX_CREATED'
        ]);
    }

    match /leads/{docId} {
      allow read:   if signedIn();
      allow create: if signedIn() && validNewLead();
      allow update: if (signedIn() && onlyWorkflowFields())
                    || (isAdmin() && onlyCorrectableFields());
      // Records are never removed from the client; delete via console or a
      // privileged Cloud Function only.
      allow delete: if false;
    }

    match /staff/{roll} {
      allow read:  if signedIn();
      allow write: if signedIn();
    }

    // Admin roster. A signed-in user may check their own membership so the
    // dashboard can show or hide the editing controls; nobody may enumerate
    // the roster, and it is writable only from the console.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
